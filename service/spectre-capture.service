[Unit]
Description=Spectre IDS Packet Capture Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/spectre
ExecStart=/opt/spectre/venv/bin/python capture.py
Environment="PATH=/opt/spectre/venv/bin"
Environment="PYTHONUNBUFFERED=1"
Restart=always
RestartSec=5
User=root
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
